{
    "name": "berqwp/berq-used-css",
    "description": "Berq Used CSS - Extract and serve only the CSS used on each page",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4",
        "voku/simple_html_dom": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "classmap": ["inc/", "admin/"]
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "exclude-from-classmap": ["build/"]
    }
}
